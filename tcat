[statuses."#"]
name = "blocked / waiting"
order = 6

[statuses."~"]
name = "snoozed"
order = 6

[statuses.">"]
name = "current"
order = 7

[statuses."="]
name = "paused / switch"
order = 7

[statuses."-"]
name = "cancelled"
order = 8

[statuses.x]
name = "done"
order = 9

[statuses.p]
