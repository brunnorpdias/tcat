weekly_folder = ""
'''

def _xdg_base():
    xdg = os.environ.get('XDG_CONFIG_HOME')
    return Path(xdg) if xdg else Path.home() / '.config'

def config_path(override):
    """Resolve the config path. Returns (path, should_bootstrap).

    Chain: --config -> $TCAT_CONFIG -> tcat/config.toml -> tdiff/config.toml
    (read-only fallback) -> bootstrap tcat/config.toml.
    """
    if override:
        return Path(override), False
    env = os.environ.get('TCAT_CONFIG')
    if env:
        return Path(env), False
    base = _xdg_base()
    own = base / 'tcat' / 'config.toml'
    if own.exists():
        return own, False
    shared = base / 'tdiff' / 'config.toml'
    if shared.exists():
        return shared, False     # read-only: never bootstrap, never warn
    return own, True

def load_config(override, error):
    """Load the status/vault table, bootstrapping tcat's own config only when neither
    a tcat nor a tdiff config exists. Populates the module-level globals."""
    global STATUS_ORDER, HIDDEN_STATUSES, PROJECT_STATUSES, DAILY_FOLDER, WEEKLY_FOLDER
    path, bootstrap = config_path(override)
    if bootstrap:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(DEFAULT_CONFIG_TOML)
        print(f"tcat: created default config at {path}", file=sys.stderr)
    if not path.exists():
        error(f"config not found: {path}")
        return
    try:
        with path.open('rb') as f:
            data = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        error(f"invalid config at {path}: {e}")
        return

    statuses = data.get('statuses', {})
    # Merge over built-ins rather than replacing: a shared tdiff config.toml has
    # neither `order` nor `hide`, and a missing rank must not collapse to 0.
    STATUS_ORDER     = dict(BUILTIN_ORDER)
    HIDDEN_STATUSES  = set(BUILTIN_HIDE)
    PROJECT_STATUSES = set(BUILTIN_PROJECTS)
    for c, v in statuses.items():
        if 'order' in v:
            STATUS_ORDER[c] = v['order']
        if 'hide' in v:
            (HIDDEN_STATUSES.add if v['hide'] else HIDDEN_STATUSES.discard)(c)
        if 'project' in v:
            (PROJECT_STATUSES.add if v['project'] else PROJECT_STATUSES.discard)(c)

    vault = data.get('vault', {})
    DAILY_FOLDER  = vault.get('daily_folder', '')
    WEEKLY_FOLDER = vault.get('weekly_folder', '')

# ── Note reading ──────────────────────────────────────────────────────────────

_NOT_FOUND_RE = re.compile(r'^Error: File ".*" not found\.$')

def read_note(name):
    """Return a note's lines, or None if it doesn't resolve. Folder-agnostic:
    `obsidian read file=` resolves a bare filename anywhere in the vault.

    `obsidian` exits 0 on a missing file and prints the error to stdout when it
    isn't attached to a TTY, so the message has to be matched explicitly."""
    r = subprocess.run(['obsidian', 'read', f'file={name}'],
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        return None
    lines = r.stdout.splitlines()
    if _NOT_FOUND_RE.match(lines[0].strip()):
        return None
    return lines

TASK_RE = re.compile(r'^(\s*)- (\[.\]) (.+)$')
H2_RE   = re.compile(r'^##\s+\*(\w+)\*')
H3_RE   = re.compile(r'^###\s+\*(\w+)\*')
MARK_RE = re.compile(r'^\*{2,3}([a-z]+)\*{2,3}\s*$')
MDLINK_RE = re.compile(r'\[([^\[\]]+)\]\([^()]*\)')

# The weekly day ladder. A whitelist, never a blacklist — the weekly template
# gains sections over time, and this is what keeps Ratio's **rationes** lines and
# Mensis's prospect checkboxes out of every day.
LADDER = ('promissum', 'sunday', 'monday', 'tuesday', 'wednesday',
          'thursday', 'friday', 'saturday', 'future')

def clean_text(s):
    """Un-escape Obsidian bracket escapes, then reduce links to their display text."""
    s = s.replace('\\[', '[').replace('\\]', ']')
    s = WIKILINK_RE.sub(
        lambda m: (m.group(1).split('|', 1)[1] if '|' in m.group(1)
                   else m.group(1).rsplit('/', 1)[-1]),
        s)
    s = MDLINK_RE.sub(lambda m: m.group(1), s)
    return strip_section_suffix(s)

def parse_note(lines, region=None, day=None, routines=False):
    """Yield (indent, status_char, name, seq) for tasks in a note.

    Fence-agnostic by design: ``` lines are ignored, never toggled. The weekly
    note's whole Fixa section is itself fenced, so toggling desynchronises. Every
    `base`/`dataviewjs` block lives under ## *Recensio*, ahead of ### *Actio*.

    region/day: when both are given, only tasks under that ### heading and that
    ladder marker are yielded (weekly mode). When neither is given, every task in
    the note is yielded (daily mode).
    """
    cur_region = cur_day = None
    seq = 0
    for line in lines:
        if H2_RE.match(line):
            cur_region = cur_day = None
            continue
        m = H3_RE.match(line)
        if m:
            cur_region = m.group(1).lower()
            cur_day = None
            continue
        m = MARK_RE.match(line)
        if m and m.group(1) in LADDER:
            # Once inside **future**, stay there: a future fence may carry its own
            # **sunday**/**other** markers that must not re-enter the ladder.
            if cur_day != 'future':
                cur_day = m.group(1)
            continue
        m = TASK_RE.match(line)
        if not m:
            continue
        if not routines and '#routine' in line:
            continue
        if region is not None and (cur_region != region or cur_day != day):
            continue
        seq += 1
        yield len(m.group(1)), m.group(2)[1], clean_text(m.group(3)), seq

def survey_region(lines, region):
    """Return (region_present, task_count, day_markers_seen) for one ### region.

    Used to tell three empty results apart: the region is missing, the week is
    genuinely empty, or the note predates the day ladder (older weekly notes list
    Actio as one flat week list with no **day** markers at all).
    """
    cur, in_future = None, False
    present, tasks, markers = False, 0, set()
    for line in lines:
        if H2_RE.match(line):
            cur, in_future = None, False
            continue
        m = H3_RE.match(line)
        if m:
            cur = m.group(1).lower()
            in_future = False
            if cur == region:
                present = True
            continue
        if cur != region:
            continue
        m = MARK_RE.match(line)
        if m and m.group(1) in LADDER:
            markers.add(m.group(1))
            if m.group(1) == 'future':
                in_future = True
            continue
        if TASK_RE.match(line) and not in_future:
            tasks += 1        # the day-list portion only, never the future bucket
    return present, tasks, markers

# ── Grouping ──────────────────────────────────────────────────────────────────

def build_groups(records):
    """Fold flat (indent, status, name, seq) records into an ordered structure.

    Returns a list of (status, name, children) where children is a list of
    (status, name, seq); a bare task has children == None. Project groups merge
    across the note (blocks are hidden, so five identical headers would be noise);
    matching is case-insensitive because one note may write both [[Project Alpha]]
    and [[project alpha]].
    """
    tops, index, current = [], {}, None
    for indent, status, name, seq in records:
        if status in PROJECT_STATUSES and indent == 0:
            key = name.lower()
            if key in index:
                current = index[key]
            else:
                current = [status, name, []]
                index[key] = current
                tops.append(current)
            continue
        if indent > 0 and current is not None:
            current[2].append((status, name, seq))
        else:
            current = None
            tops.append([status, name, None])
    return tops

def dedup(items):
    """Reduce (status, name, seq) triples to one (status, name) per logical task.

    Position is what decides the winner, so the seq is consumed here and never
    escapes: every caller sorts by (status rank, name), never by page order.
    """
    if not items:
        return []
    tasks, order = materialize(cluster_records([(n, s, q) for s, n, q in items]))
    return [(tasks[n], n) for n in order]

def sort_key(status, name):
    return (STATUS_ORDER.get(status, UNRANKED), name.lower())

# ── Argument parsing ──────────────────────────────────────────────────────────

parser = argparse.ArgumentParser(
    prog='tcat',
    description="Show one day's tasks from an Obsidian daily or weekly note.",
    epilog=(
        'Dates accept YYYY-MM-DD, "today", "yesterday", "tomorrow", "0" (today), '
        '-N / +N (e.g. -1 for yesterday), or a weekday name (monday..sunday, or '
        'mon..sun), which resolves to its most recent occurrence at or before today.'
    ),
)
parser.add_argument('date', nargs='?', default='today', help='the day to show (default: today)')
parser.add_argument('-P', '--plan',     action='store_true',
                    help="read the weekly note's Actio allocation for that day "
                         '(the plan) instead of the daily note')
parser.add_argument('-f', '--flat',     action='store_true',
                    help='drop project grouping and promote children to top level, '
                         'sorted alphabetically (the task set tdiff sees)')
parser.add_argument('-S', '--status',   type=str, default=None,
                    help="show only tasks whose status is in the given set "
                         "(concatenated chars, e.g. 'x-#'); prefix '^' to invert "
                         "(e.g. '^x'). Overrides hidden statuses. Bare '-S -' looks "
                         "like a flag to argparse; use -S=- or quote in a set ('x-')")
parser.add_argument('--routines',       action='store_true', help='include #routine tasks')
parser.add_argument('--json',           action='store_true', help='machine-readable output')
parser.add_argument('-v', '--verbose',  action='store_true',
                    help='report why the output was empty')
parser.add_argument('--no-color',       action='store_true', help='disable colored output')
parser.add_argument('--no-summary',     action='store_true', help='suppress the summary line')
parser.add_argument('--config',         type=str, default=None,
                    help='path to status config TOML; default resolution: $TCAT_CONFIG, '
                         '$XDG_CONFIG_HOME/tcat/config.toml, then tdiff/config.toml')

# argparse chokes on bare negative numbers like -1 before we can process them;
# intercept them and turn them into a safe token first.
raw = sys.argv[1:]
safe = [('__NEG__' + a[1:]) if re.fullmatch(r'-\d+', a) else a for a in raw]
args = parser.parse_args(safe)

load_config(args.config, parser.error)

def restore(s):
    if s.startswith('__NEG__'):
        return '-' + s[7:]
    return s

_ISO_RE = re.compile(r'\d{4}-\d{2}-\d{2}')
_OFF_RE = re.compile(r'([-+])(\d+)')

WEEKDAYS = {n: i for i, n in enumerate(
    ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'])}
WEEKDAYS.update({n[:3]: i for n, i in list(WEEKDAYS.items())})

def resolve_date(s):
    today = date.today()
    if s in ('today', '0'):
        return today.isoformat()
    if s == 'yesterday':
        return (today - timedelta(days=1)).isoformat()
    if s == 'tomorrow':
        return (today + timedelta(days=1)).isoformat()
    low = s.lower()
    if low in WEEKDAYS:
        # Backwards: the most recent occurrence at or before today. A future day
        # has no tasks yet, so resolving forwards would always come back empty.
        days_back = (today.weekday() - WEEKDAYS[low]) % 7
        return (today - timedelta(days=days_back)).isoformat()
    m = _OFF_RE.fullmatch(s)
    if m:
        n = int(m.group(2))
        if n < 1:
            parser.error(f"invalid date: {s!r} (use 0 for today)")
        delta = -n if m.group(1) == '-' else n
        return (today + timedelta(days=delta)).isoformat()
    if _ISO_RE.fullmatch(s):
        try:
            return date.fromisoformat(s).isoformat()
        except ValueError:
            parser.error(f"invalid date: {s!r}")
    parser.error(
        f"invalid date: {s!r} (expected YYYY-MM-DD, 'today', 'yesterday', "
        f"'tomorrow', '0', -N/+N, or a weekday name)"
    )

target = resolve_date(restore(args.date))
target_d = date.fromisoformat(target)

if target_d > date.today() and not args.plan:
    parser.error(
        f"{target} is in the future; a daily note won't exist yet. "
        f"Use -P to read the weekly plan's allocation for that day."
    )

status_filter = None
if args.status is not None:
    v = restore(args.status)
    negate = v.startswith('^')
    if negate:
        v = v[1:]
    chars = set(v)
    if not chars:
        parser.error("--status expects at least one status char (e.g. 'x-#' or '^x')")
    status_filter = (chars, negate)

def status_match(ch):
    if status_filter is None:
        return ch not in HIDDEN_STATUSES
    chars, negate = status_filter
    return (ch not in chars) if negate else (ch in chars)

# ── Colors ────────────────────────────────────────────────────────────────────

use_color = not args.no_color and sys.stdout.isatty()
CYAN   = '\033[36m' if use_color else ''
DIM    = '\033[2m'  if use_color else ''
BOLD   = '\033[1m'  if use_color else ''
RESET  = '\033[0m'  if use_color else ''

# ── Load ──────────────────────────────────────────────────────────────────────

WEEKDAY_NAME = ['monday', 'tuesday', 'wednesday', 'thursday',
                'friday', 'saturday', 'sunday'][target_d.weekday()]
_, _, week_label = week_span(target_d)

if args.plan:
    note_name = f'{WEEKLY_FOLDER}/{week_label}' if WEEKLY_FOLDER else week_label
    source = week_label
else:
    note_name = f'{DAILY_FOLDER}/{target}' if DAILY_FOLDER else target
    source = 'daily'

lines = read_note(note_name)

reason = None
records = []
if lines is None:
    reason = f"no note found for '{note_name}'"
elif args.plan:
    records = list(parse_note(lines, region='actio', day=WEEKDAY_NAME,
                              routines=args.routines))
    if not records:
        present, n_tasks, markers = survey_region(lines, 'actio')
        days_seen = markers - {'promissum', 'future'}
        if not present:
            reason = f"{week_label} has no ### *Actio* section"
        elif n_tasks and not days_seen:
            reason = (f"{week_label} predates the day ladder: its Actio holds "
                      f"{n_tasks} task{'' if n_tasks == 1 else 's'} as one flat "
                      f"week list, not split by day")
        elif not n_tasks:
            reason = f"{week_label}'s Actio is empty"
        else:
            reason = f"nothing allocated to {WEEKDAY_NAME} in {week_label}'s Actio"
else:
    records = list(parse_note(lines, routines=args.routines))
    if not records:
        reason = f"{target} has no tasks"

# ── Assemble ──────────────────────────────────────────────────────────────────

rows = []          # (status, name, children) — children None for a bare task
if args.flat:
    flat = [(s, n, q) for _, s, n, q in records if s not in PROJECT_STATUSES]
    for status, name in dedup(flat):
        if status_match(status):
            rows.append((status, name, None))
    rows.sort(key=lambda r: r[1].lower())   # --flat: alphabetical only
else:
    for status, name, children in build_groups(records):
        if children is None:
            if status_match(status):
                rows.append((status, name, None))
            continue
        kids = [(s, n) for s, n in dedup(children) if status_match(s)]
        kids.sort(key=lambda k: sort_key(k[0], k[1]))
        # A project whose every child was filtered out is not worth a header.
        if kids:
            rows.append((status, name, kids))
    rows.sort(key=lambda r: sort_key(r[0], r[1]))

# ── Output ────────────────────────────────────────────────────────────────────

if args.json:
    print(json.dumps({
        'date': target,
        'weekday': WEEKDAY_NAME,
        'week': week_label,
        'source': source,
        'reason': reason,
        'tasks': [
            {'status': s, 'name': n,
             'children': None if k is None else [{'status': cs, 'name': cn} for cs, cn in k]}
            for s, n, k in rows
        ],
    }, ensure_ascii=False, indent=2))
    sys.exit(0)

print(f"{BOLD}{target}{RESET}  {DIM}·{RESET}  {WEEKDAY_NAME[:3]}  {DIM}·{RESET}  {CYAN}{source}{RESET}")
print()

leaves = 0
for status, name, kids in rows:
    print(f"  [{status}] {name}")
    if kids is None:
        leaves += 1
        continue
    for cs, cn in kids:
        print(f"      [{cs}] {cn}")
        leaves += 1

