# DIVERGENCE from tdiff: tcat reduces a cluster by *page position*, not by
# STATUS_PRIORITY. Within a single note the last occurrence is the most recent
# statement of a task's state, so it wins outright.
def materialize(clusters):
    """Reduce each cluster to (canonical_base, winning_status). Last occurrence wins."""
    tasks, order = {}, []
    for members in clusters:
        last = max(members, key=lambda r: r[2])
        canonical, winning = last[0], last[1]
        order.append(canonical)
        tasks[canonical] = winning
    return tasks, order

