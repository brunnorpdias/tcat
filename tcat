def _xdg_base():
    xdg = os.environ.get('XDG_CONFIG_HOME')
    return Path(xdg) if xdg else Path.home() / '.config'

def config_path(override):
    """Resolve the config path. Returns (path, should_bootstrap).

    Chain: --config -> $TCAT_CONFIG -> tcat/config.toml -> tdiff/config.toml
    (read-only fallback) -> bootstrap tcat/config.toml.
    """
    if override:
        return Path(override), False
    env = os.environ.get('TCAT_CONFIG')
    if env:
        return Path(env), False
    base = _xdg_base()
    own = base / 'tcat' / 'config.toml'
    if own.exists():
        return own, False
    shared = base / 'tdiff' / 'config.toml'
    if shared.exists():
        return shared, False     # read-only: never bootstrap, never warn
    return own, True

def load_config(override, error):
    """Load the status/vault table, bootstrapping tcat's own config only when neither
    a tcat nor a tdiff config exists. Populates the module-level globals."""
    global STATUS_ORDER, HIDDEN_STATUSES, PROJECT_STATUSES, DAILY_FOLDER, WEEKLY_FOLDER
    path, bootstrap = config_path(override)
    if bootstrap:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(DEFAULT_CONFIG_TOML)
        print(f"tcat: created default config at {path}", file=sys.stderr)
    if not path.exists():
        error(f"config not found: {path}")
        return
    try:
        with path.open('rb') as f:
            data = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        error(f"invalid config at {path}: {e}")
        return

    statuses = data.get('statuses', {})
    # Merge over built-ins rather than replacing: a shared tdiff config.toml has
    # neither `order` nor `hide`, and a missing rank must not collapse to 0.
    STATUS_ORDER     = dict(BUILTIN_ORDER)
    HIDDEN_STATUSES  = set(BUILTIN_HIDE)
    PROJECT_STATUSES = set(BUILTIN_PROJECTS)
    for c, v in statuses.items():
        if 'order' in v:
            STATUS_ORDER[c] = v['order']
        if 'hide' in v:
            (HIDDEN_STATUSES.add if v['hide'] else HIDDEN_STATUSES.discard)(c)
        if 'project' in v:
            (PROJECT_STATUSES.add if v['project'] else PROJECT_STATUSES.discard)(c)

    vault = data.get('vault', {})
    DAILY_FOLDER  = vault.get('daily_folder', '')
    WEEKLY_FOLDER = vault.get('weekly_folder', '')

# ── Note reading ──────────────────────────────────────────────────────────────

_NOT_FOUND_RE = re.compile(r'^Error: File ".*" not found\.$')

# -A reads seven notes where every other mode reads one. Each call is mostly spent
# waiting on the obsidian app, so overlapping them is most of the win; 4 workers is
# plenty, because the app is a single process on the other end. TCAT_WORKERS=1
# forces serial reads.
def _env_num(name, default, cast):
    try:
        return cast(os.environ[name])
    except (KeyError, ValueError):
        return default

FETCH_WORKERS = max(1, _env_num('TCAT_WORKERS', 4, int))

# The obsidian CLI occasionally wedges on a read that normally takes ~10ms —
# observed in this vault, and the reason tdiff caps and retries its calls too. A
# single-note mode would just look slow; -A makes seven calls, so the odds of
# meeting a stalled one are seven times higher. Cap, retry, move on.
FETCH_TIMEOUT  = _env_num('TCAT_TIMEOUT', 5.0, float)
FETCH_ATTEMPTS = max(1, _env_num('TCAT_ATTEMPTS', 3, int))

_lines_cache = {}

def _read_uncached(name):
    # stdin=DEVNULL matters: the obsidian CLI drains stdin, so without it `tcat`
    # silently eats whatever is being piped into the script that called it.
    for attempt in range(FETCH_ATTEMPTS):
        try:
            r = subprocess.run(['obsidian', 'read', f'file={name}'],
                               capture_output=True, text=True,
                               stdin=subprocess.DEVNULL, timeout=FETCH_TIMEOUT)
            break
        except subprocess.TimeoutExpired:
            if attempt == FETCH_ATTEMPTS - 1:
                print(f"tcat: obsidian did not answer for '{name}' after "
                      f"{FETCH_ATTEMPTS} attempts; skipping it", file=sys.stderr)
                return None
    if r.returncode != 0 or not r.stdout.strip():
        return None
    lines = r.stdout.splitlines()
    if _NOT_FOUND_RE.match(lines[0].strip()):
        return None
    return lines

def read_note(name):
    """Return a note's lines, or None if it doesn't resolve. Folder-agnostic:
    `obsidian read file=` resolves a bare filename anywhere in the vault.

    `obsidian` exits 0 on a missing file and prints the error to stdout when it
    isn't attached to a TTY, so the message has to be matched explicitly."""
    if name not in _lines_cache:
        _lines_cache[name] = _read_uncached(name)
    return _lines_cache[name]

def prefetch(names):
    """Warm the cache for several notes at once. Single-note modes never call this,
    so they keep exactly the cost they had before."""
    todo = [n for n in dict.fromkeys(names) if n not in _lines_cache]
    if FETCH_WORKERS < 2 or len(todo) < 2:
        for n in todo:
            read_note(n)
        return
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=min(FETCH_WORKERS, len(todo))) as ex:
        for n, lines in zip(todo, ex.map(_read_uncached, todo)):
            _lines_cache[n] = lines

TASK_RE = re.compile(r'^(\s*)- (\[.\]) (.+)$')
H2_RE   = re.compile(r'^##\s+\*(\w+)\*')
H3_RE   = re.compile(r'^###\s+\*(\w+)\*')
MARK_RE = re.compile(r'^\*{2,3}([a-z]+)\*{2,3}\s*$')
MDLINK_RE = re.compile(r'\[([^\[\]]+)\]\([^()]*\)')

# The weekly day ladder. A whitelist, never a blacklist — the weekly template
# gains sections over time, and this is what keeps Ratio's **rationes** lines and
# Mensis's prospect checkboxes out of every day.
#
# WEEK_DAYS is the ladder's day span on its own: -A asks for all seven at once,
# and deriving LADDER from it keeps the two from drifting apart.
WEEK_DAYS = ('sunday', 'monday', 'tuesday', 'wednesday',
             'thursday', 'friday', 'saturday')
LADDER = ('promissum',) + WEEK_DAYS + ('future',)

def clean_text(s):
    """Un-escape Obsidian bracket escapes, then reduce links to their display text."""
    s = s.replace('\\[', '[').replace('\\]', ']')
    s = WIKILINK_RE.sub(
        lambda m: (m.group(1).split('|', 1)[1] if '|' in m.group(1)
                   else m.group(1).rsplit('/', 1)[-1]),
        s)
    s = MDLINK_RE.sub(lambda m: m.group(1), s)
    return strip_section_suffix(s)

def parse_note(lines, region=None, day=None, routines=False, skip_future=False):
    """Yield (indent, status_char, name, seq) for tasks in a note.

    Fence-agnostic by design: ``` lines are ignored, never toggled. The weekly
    note's whole Fixa section is itself fenced, so toggling desynchronises. Every
    `base`/`dataviewjs` block lives under ## *Recensio*, ahead of ### *Actio*.

    region/day: when both are given, only tasks under that ### heading and that
    ladder marker are yielded (weekly mode). `day` takes one marker name or a
    tuple of them — WEEK_DAYS folds the whole week into one pass, which is what
    -A -P wants. When neither is given, every task in the note is yielded (daily
    mode).

    skip_future: drop tasks sitting under a **future** marker. Only -A passes it.
    A daily note's future bucket is fair to show for that one day, but aggregating
    a week would fold deferred work in alongside what actually happened — and a
    pre-split Sunday's bucket holds a whole week of it.
    """
    days = (day,) if isinstance(day, str) else day
    cur_region = cur_day = None
    seq = 0
    for line in lines:
        if H2_RE.match(line):
            cur_region = cur_day = None
            continue
        m = H3_RE.match(line)
        if m:
            cur_region = m.group(1).lower()
            cur_day = None
            continue
        m = MARK_RE.match(line)
        if m and m.group(1) in LADDER:
            # Once inside **future**, stay there: a future fence may carry its own
            # **sunday**/**other** markers that must not re-enter the ladder.
            if cur_day != 'future':
                cur_day = m.group(1)
            continue
        m = TASK_RE.match(line)
        if not m:
            continue
        if not routines and '#routine' in line:
            continue
        if skip_future and cur_day == 'future':
            continue
        if region is not None and (cur_region != region or cur_day not in days):
            continue
        seq += 1
        yield len(m.group(1)), m.group(2)[1], clean_text(m.group(3)), seq

def survey_region(lines, region):
    """Return (region_present, task_count, day_markers_seen) for one ### region.

    Used to tell three empty results apart: the region is missing, the week is
    genuinely empty, or the note predates the day ladder (older weekly notes list
    Actio as one flat week list with no **day** markers at all).
    """
    cur, in_future = None, False
    present, tasks, markers = False, 0, set()
    for line in lines:
        if H2_RE.match(line):
            cur, in_future = None, False
            continue
        m = H3_RE.match(line)
        if m:
            cur = m.group(1).lower()
            in_future = False
            if cur == region:
                present = True
            continue
        if cur != region:
            continue
        m = MARK_RE.match(line)
        if m and m.group(1) in LADDER:
            markers.add(m.group(1))
            if m.group(1) == 'future':
                in_future = True
            continue
        if TASK_RE.match(line) and not in_future:
            tasks += 1        # the day-list portion only, never the future bucket
    return present, tasks, markers

_HEAD_RE = re.compile(r'^#{1,6}\s')

def extract_section(lines, name):
    """Return one ### section's body verbatim, or None if the heading is absent.

    The body runs from the heading to the next heading of any level. Leading and
    trailing blank lines are stripped; everything else is untouched — no link
    cleaning, no comment stripping, no section-suffix trimming. A heading with an
    empty body returns '', which is what tells 'no such section' apart from
    'nothing written there yet'.

    Fence-agnostic like parse_note(): ``` lines are ignored. Safe here because
    ### *Missio* carries prose only — every fenced block in the weekly note
    (base/dataviewjs/markdown) lives under ## *Recensio* or ### *Fixa*.
    """
    body, inside = [], False
    for line in lines:
        if inside:
            if _HEAD_RE.match(line):
                break
            body.append(line)
            continue
        m = H3_RE.match(line)
        if m and m.group(1).lower() == name:
            inside = True
    if not inside:
        return None
    while body and not body[0].strip():
        body.pop(0)
    while body and not body[-1].strip():
        body.pop()
    return '\n'.join(body)

# ── Grouping ──────────────────────────────────────────────────────────────────

def build_groups(records):
    """Fold flat (indent, status, name, seq) records into an ordered structure.

    Returns a list of (status, name, children) where children is a list of
    (status, name, seq); a bare task has children == None. Project groups merge
    across the note (blocks are hidden, so five identical headers would be noise);
    matching is case-insensitive because one note may write both [[Project Alpha]]
    and [[project alpha]].
    """
    tops, index, current = [], {}, None
    for indent, status, name, seq in records:
        if status in PROJECT_STATUSES and indent == 0:
            key = name.lower()
            if key in index:
                current = index[key]
            else:
                current = [status, name, []]
                index[key] = current
                tops.append(current)
            continue
        if indent > 0 and current is not None:
            current[2].append((status, name, seq))
        else:
            current = None
            tops.append([status, name, None])
    return tops

def dedup(items):
    """Reduce (status, name, seq) triples to one (status, name) per logical task.

    Position is what decides the winner, so the seq is consumed here and never
    escapes: every caller sorts by (status rank, name), never by page order.
    """
    if not items:
        return []
    tasks, order = materialize(cluster_records([(n, s, q) for s, n, q in items]))
    return [(tasks[n], n) for n in order]

def sort_key(status, name):
    return (STATUS_ORDER.get(status, UNRANKED), name.lower())

