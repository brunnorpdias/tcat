#!/usr/bin/env python3
"""tcat — show one day's tasks from an Obsidian vault.

Sibling to `tdiff`. `tdiff` answers *what changed*; `tcat` answers *what is there*.
It never compares two sources — every comparison stays with `tdiff`.
"""
import sys, re, os, subprocess, argparse, json, tomllib
from datetime import date, timedelta
from pathlib import Path

# ── Vendored task core ────────────────────────────────────────────────────────
# Synced from brunnorpdias/tdiff@1e7f11c ("make vault lookups folder-agnostic,
# move status config to toml"). Keep this block byte-identical to tdiff's where
# marked; tools/check-core-sync.sh verifies it. Divergences are called out inline.

_SEP_RE = re.compile(r' [-–—] ')  # hyphen, en-dash, em-dash

def strip_section_suffix(s):
    """Remove trailing ' – ...' only when the dash is outside of [...] brackets."""
    depth = 0
    for i, c in enumerate(s):
        if c == '[':
            depth += 1
        elif c == ']':
            depth = max(0, depth - 1)
        elif depth == 0 and c == ' ' and _SEP_RE.match(s, i):
            return s[:i].strip()
    return s.strip()

WIKILINK_RE = re.compile(r'\[\[([^\[\]]+)\]\]')

def _strip_wiki_path(m):
    inner = m.group(1)
    if '|' in inner:
        target, alias = inner.split('|', 1)
        return f'[[{target.rsplit("/", 1)[-1]}|{alias}]]'
    return f'[[{inner.rsplit("/", 1)[-1]}]]'

def normalize_wikilinks(s):
    return WIKILINK_RE.sub(_strip_wiki_path, s)

_PUNCT = ',.;:!?-—…'

def _tokens(s):
    out = []
    for t in s.split():
        t = t.lower().strip(_PUNCT)
        if t:
            out.append(t)
    return out

def is_same_task(a, b):
    """Predicate: same logical task. Token-set equality, or strict subset sharing first word."""
    ta, tb = _tokens(a), _tokens(b)
    sa, sb = set(ta), set(tb)
    if not sa or not sb:
        return a == b
    if sa == sb:
        return True
    if (sa < sb or sb < sa) and ta and tb and ta[0] == tb[0]:
        return True
    return False

def cluster_records(records):
    """Cluster records by is_same_task using union-find. Returns list of clusters
    (each a list of records) in first-seen order of their root base."""
    bases_in_order, seen = [], set()
    for base, _, _ in records:
        if base not in seen:
            seen.add(base)
            bases_in_order.append(base)

    parent = {b: b for b in bases_in_order}
    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x
    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[ra] = rb

    for i, a in enumerate(bases_in_order):
        for b in bases_in_order[i + 1:]:
            if is_same_task(a, b):
                union(a, b)

    by_root = {}
    for rec in records:
        by_root.setdefault(find(rec[0]), []).append(rec)

    clusters, emitted = [], set()
    for b in bases_in_order:
        r = find(b)
        if r in emitted:
            continue
        emitted.add(r)
        clusters.append(by_root[r])
    return clusters

def week_span(d):
    """Return (sunday, saturday, label) for the US-format Sun-Sat week containing d."""
    if isinstance(d, str):
        d = date.fromisoformat(d)
    days_back = (d.weekday() + 1) % 7   # Mon=0..Sun=6 -> Sun=0
    sun = d - timedelta(days=days_back)
    sat = sun + timedelta(days=6)
    jan1 = date(sun.year, 1, 1)
    days_back = 0 if jan1.isoweekday() == 7 else jan1.isoweekday()
    week_num = ((sun - jan1).days + days_back) // 7 + 1
    return sun, sat, f"{sun.year}-W{week_num:02d}"

# ── End vendored core ─────────────────────────────────────────────────────────

# DIVERGENCE from tdiff: tcat reduces a cluster by *page position*, not by
# STATUS_PRIORITY. Within a single note the last occurrence is the most recent
# statement of a task's state, so it wins outright.
def materialize(clusters):
    """Reduce each cluster to (canonical_base, winning_status). Last occurrence wins."""
    tasks, order = {}, []
    for members in clusters:
        last = max(members, key=lambda r: r[2])
        canonical, winning = last[0], last[1]
        order.append(canonical)
        tasks[canonical] = winning
    return tasks, order

# Populated by load_config(). Placeholder values so nothing explodes if referenced
# before load_config() runs.
STATUS_ORDER     = {}
HIDDEN_STATUSES  = set()
PROJECT_STATUSES = set()
DAILY_FOLDER  = ''
WEEKLY_FOLDER = ''

# Built-in display ranks. Merged *under* whatever the config supplies, so a shared
# tdiff config.toml (which has no `order`/`hide` keys) still sorts correctly.
BUILTIN_ORDER = {
    'u': 0,                      # urgent project
    'i': 1,                      # important project
    '!': 2,                      # urgent
    '*': 3,                      # important
    'o': 4,                      # recurrent
    ' ': 5, '/': 5,              # task, partial
    '#': 6, '~': 6,              # blocked / waiting, snoozed
    '>': 7, '=': 7,              # current, paused / switch
    '-': 8,                      # cancelled
    'x': 9,                      # done
    'p': 10,                     # project
}
BUILTIN_HIDE     = {'&', '»', '«'}   # overrun, postponed, advanced
BUILTIN_PROJECTS = {'p', 'i', 'u'}
UNRANKED = 99

DEFAULT_CONFIG_TOML = '''\
