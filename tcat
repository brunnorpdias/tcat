#                    suppresses a later [x]. -S overrides.
#   project = true   structural marker; opens a project group in the default view
#                    and is dropped entirely by --flat.
#
# tcat also reads tdiff's config.toml when no tcat config exists, so the two tools
# share one status table. tdiff's `priority` and `ignore` keys are ignored here:
# tcat dedups by page position, and `ignore` is a diff-side concept.

[statuses.u]
name = "urgent project"
