#!/usr/bin/env python3
"""tcat — show one day's tasks from an Obsidian vault.

Sibling to `tdiff`. `tdiff` answers *what changed*; `tcat` answers *what is there*.
It never compares two sources — every comparison stays with `tdiff`.
"""
import sys, re, os, time, threading, subprocess, argparse, json, tomllib
from concurrent.futures import ThreadPoolExecutor
from datetime import date, timedelta
from pathlib import Path

# ── Vendored task core ────────────────────────────────────────────────────────
# Synced from brunnorpdias/tdiff@92f195c ("name weeks relative to this one").
# Keep this block byte-identical to tdiff's where marked; tools/check-core-sync.sh
# verifies it. Divergences are called out inline.

_SEP_RE = re.compile(r' [-–—] ')  # hyphen, en-dash, em-dash

def strip_section_suffix(s):
    """Remove trailing ' – ...' only when the dash is outside of [...] brackets."""
    depth = 0
    for i, c in enumerate(s):
        if c == '[':
            depth += 1
        elif c == ']':
            depth = max(0, depth - 1)
        elif depth == 0 and c == ' ' and _SEP_RE.match(s, i):
            return s[:i].strip()
    return s.strip()

WIKILINK_RE = re.compile(r'\[\[([^\[\]]+)\]\]')

def _strip_wiki_path(m):
    inner = m.group(1)
    if '|' in inner:
        target, alias = inner.split('|', 1)
        return f'[[{target.rsplit("/", 1)[-1]}|{alias}]]'
    return f'[[{inner.rsplit("/", 1)[-1]}]]'

def normalize_wikilinks(s):
    return WIKILINK_RE.sub(_strip_wiki_path, s)

_PUNCT = ',.;:!?-—…'

def _tokens(s):
    out = []
    for t in s.split():
        t = t.lower().strip(_PUNCT)
        if t:
            out.append(t)
    return out

def cluster_records(records):
    """Cluster records that name the same logical task, using union-find. Two bases
    are the same task when their token sets are equal, or when one is a strict subset
    of the other and both start with the same token. Returns a list of clusters (each
    a list of records) in first-seen order of their root base."""
    bases_in_order, seen = [], set()
    for base, _, _ in records:
        if base not in seen:
            seen.add(base)
            bases_in_order.append(base)

    parent = {b: b for b in bases_in_order}
    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x
    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[ra] = rb

    # Bucketing on the two merge keys gives the same clusters as an all-pairs scan
    # without tokenizing (or comparing) every pair. Tokenless bases could only merge
    # by exact string equality, which distinct bases never satisfy — so skip them.
    by_tokens, by_first = {}, {}
    for b in bases_in_order:
        toks = _tokens(b)
        if not toks:
            continue
        key = frozenset(toks)
        by_tokens.setdefault(key, []).append(b)
        by_first.setdefault(toks[0], []).append((b, key))

    for group in by_tokens.values():
        for b in group[1:]:
            union(group[0], b)
    for group in by_first.values():
        for i, (a, sa) in enumerate(group):
            for b, sb in group[i + 1:]:
                if sa < sb or sb < sa:
                    union(a, b)

    by_root = {}
    for rec in records:
        by_root.setdefault(find(rec[0]), []).append(rec)

    clusters, emitted = [], set()
    for b in bases_in_order:
        r = find(b)
        if r in emitted:
            continue
        emitted.add(r)
        clusters.append(by_root[r])
    return clusters

def week_span(d):
    """Return (sunday, saturday, label) for the US-format Sun-Sat week containing d."""
    if isinstance(d, str):
        d = date.fromisoformat(d)
    days_back = (d.weekday() + 1) % 7   # Mon=0..Sun=6 -> Sun=0
    sun = d - timedelta(days=days_back)
    sat = sun + timedelta(days=6)
    # The label's year is the *Saturday's*, not the Sunday's. Week 1 is the week
    # containing Jan 1, so a week straddling New Year belongs to the year it ends
    # in — which is what the vault's moment `gggg[-W]ww` filenames say. Anchoring
    # on the Sunday called Sun 2026-12-27 → Sat 2027-01-02 `2026-W53`, a file that
    # does not exist, and made the vault's real `2027-W01` unreachable by name.
    # Only the straddling week per year is affected; all others are unchanged.
    jan1 = date(sat.year, 1, 1)
    days_back = 0 if jan1.isoweekday() == 7 else jan1.isoweekday()
    week_num = ((sun - jan1).days + days_back) // 7 + 1
    return sun, sat, f"{sat.year}-W{week_num:02d}"

_WEEK_REL_RE   = re.compile(r'[wW]([-+]\d+|0)$')
_WEEK_SHORT_RE = re.compile(r'[wW](\d{1,2})$')
_WEEK_FULL_RE  = re.compile(r'[wW](\d{4}-W\d{2})$')

def resolve_week_label(s):
    """Return 'YYYY-W##' if s is a w## specifier, else None.

    Three spellings, tried in this order. `w2026-W30` names a week outright. `w-1` / `w0`
    / `w+1` are relative to the week containing today, and are what replaced the offset
    flags both tools used to carry. `w30` is a bare week number in the current year.

    The relative form has to be tried before the bare number, or `w0` would read as week
    zero — a week no calendar has, and one that used to resolve to a phantom label.
    """
    m = _WEEK_FULL_RE.fullmatch(s)
    if m:
        return m.group(1)
    m = _WEEK_REL_RE.fullmatch(s)
    if m:
        return week_span(date.today() + timedelta(weeks=int(m.group(1))))[2]
    m = _WEEK_SHORT_RE.fullmatch(s)
    if m:
        return f'{date.today().year}-W{int(m.group(1)):02d}'
    return None

def _week_label_to_sunday(week_label):
    """Convert 'YYYY-W##' (US convention: week 1 contains Jan 1, weeks start Sunday)."""
    year, week_num = int(week_label[:4]), int(week_label[6:])
    jan1 = date(year, 1, 1)
    days_back = 0 if jan1.isoweekday() == 7 else jan1.isoweekday()
    return jan1 - timedelta(days=days_back) + timedelta(weeks=week_num - 1)

# ── End vendored core ─────────────────────────────────────────────────────────

# DIVERGENCE from tdiff: tcat reduces a cluster by *page position*, not by
# STATUS_PRIORITY. Within a single note the last occurrence is the most recent
# statement of a task's state, so it wins outright.
def materialize(clusters):
    """Reduce each cluster to (canonical_base, winning_status). Last occurrence wins."""
    tasks, order = {}, []
    for members in clusters:
        last = max(members, key=lambda r: r[2])
        canonical, winning = last[0], last[1]
        order.append(canonical)
        tasks[canonical] = winning
    return tasks, order

# Populated by load_config(). Placeholder values so nothing explodes if referenced
# before load_config() runs.
#
# There are deliberately NO built-in ranks, colours or roles. The status vocabulary
# describes the user's vault, not this tool, and inventing a fallback table is how
# the old build ended up sorting by ranks nobody had chosen. With no config at all
# tcat still runs — everything unranked and uncoloured — and says so once on stderr.
DISPLAY_ORDER     = {}     # char -> rank, derived from [order].statuses position
THEMES           = {}     # theme name -> {char: '#rrggbb'}
FULL_ROW         = set()  # statuses whose whole row takes the colour, not just [x]
HIDDEN_STATUSES  = set()
SETTLED_STATUSES = set()  # terminal states, hidden only when -I asks
PROJECT_STATUSES = set()
DAILY_FOLDER  = ''
WEEKLY_FOLDER = ''
CONFIG_FOUND  = False

# Anything absent from [order].statuses sorts last, in a block, alphabetically.
UNRANKED = 10 ** 6

def display_rank(ch):
    """Sort rank for a status char, from [order].statuses.

    A status the table does not list ranks last as a block — alphabetical within it,
    since the name is the next sort key — which is what the shipped statuses.toml
    promises and what tcat does with the same list. report_unlisted() names them.
    """
    return DISPLAY_ORDER.get(ch, UNRANKED)

# Config complaints are advisory, never fatal, and never belong in a pipe: they are
# collected here and flushed to stderr at the end, unless --json or --no-summary
# asked for output with nothing around it.
NOTICES = []

def notice(msg):
    NOTICES.append(msg)

def _merge(base, overlay):
    """Recursive dict merge; the overlay wins.

    Lists replace wholesale rather than concatenating: an overlay that names a
    partial [order].statuses means exactly that order, not an insertion into a
    lower layer's list.
    """
    for k, v in overlay.items():
        if isinstance(v, dict) and isinstance(base.get(k), dict):
            _merge(base[k], v)
        else:
            base[k] = v

def _xdg_base():
    xdg = os.environ.get('XDG_CONFIG_HOME')
    return Path(xdg) if xdg else Path.home() / '.config'

def config_paths(override):
    """Every config source, lowest precedence first.

    The status table describes the vault's notation, not this tool, so its home is
    obsidian-tasks/ — a directory neither tcat nor tdiff owns, which is what lets
    the two share one table without either depending on the other being installed.
    tcat's own directory is an optional overlay for tcat-only settings.

    Each source *merges* over the ones below it, including $TCAT_CONFIG and
    --config. A partial file must never erase what a lower layer set.
    """
    base = _xdg_base()
    paths = [base / 'obsidian-tasks' / 'statuses.toml',
             base / 'tcat' / 'config.toml']
    env = os.environ.get('TCAT_CONFIG')
    if env:
        paths.append(Path(env))
    if override:
        paths.append(Path(override))
    return paths

def load_config(override, error):
    """Merge every config layer and populate the module-level globals.

    Never bootstraps a file and never fails on a missing one: no config is a valid
    (if uncoloured) state, reported once by notice(). Only unparseable TOML is an
    error.
    """
    global DISPLAY_ORDER, THEMES, FULL_ROW, HIDDEN_STATUSES, PROJECT_STATUSES
    global SETTLED_STATUSES, DAILY_FOLDER, WEEKLY_FOLDER, CONFIG_FOUND

    merged = {}
    for path in config_paths(override):
        if not path.exists():
            continue
        try:
            with path.open('rb') as f:
                data = tomllib.load(f)
        except tomllib.TOMLDecodeError as e:
            error(f'invalid config at {path}: {e}')
            return
        CONFIG_FOUND = True
        _merge(merged, data)

    # Rank is list position, so ties cannot be expressed and reordering is a move.
    statuses = merged.get('order', {}).get('statuses', [])
    DISPLAY_ORDER = {c: i for i, c in enumerate(statuses)}

    THEMES = {name: dict(table)
              for name, table in merged.get('theme', {}).items()
              if isinstance(table, dict)}

    roles = merged.get('roles', {})
    PROJECT_STATUSES = set(roles.get('project', []))
    HIDDEN_STATUSES  = set(roles.get('hide', []))
    SETTLED_STATUSES = set(roles.get('settled', []))
    FULL_ROW         = set(roles.get('full_row', []))

    vault = merged.get('vault', {})
    DAILY_FOLDER  = vault.get('daily_folder', '')
    WEEKLY_FOLDER = vault.get('weekly_folder', '')


# ── Note reading ──────────────────────────────────────────────────────────────

class ObsidianError(Exception):
    """The obsidian CLI could not be run, or reported an error we can't interpret.
    `retry` is False for permanent failures (no binary), True for ones observed to be
    transient. `stalled` marks the timeout case, which is worth telling the user about
    because it's the only failure they feel as a pause."""
    def __init__(self, msg, retry=True, stalled=False):
        super().__init__(msg)
        self.retry = retry
        self.stalled = stalled

# A note that simply doesn't exist is normal (a day with no note, a week with no
# planning note) — obsidian reports it on stdout with exit status 0.
_MISSING_FILE_RE = re.compile(r'^Error: File "[^"]*" not found\.$')
_NEW_PREFIX_RE   = re.compile(r'^\(new\)\s*', re.IGNORECASE)

def _env_int(name, default):
    try:
        return max(1, int(os.environ[name]))
    except (KeyError, ValueError):
        return default

# Concurrency is a small win (4 and 8 workers measure the same), so keep it low —
# the obsidian CLI talks to a single running app. TCAT_WORKERS=1 forces serial reads.
FETCH_WORKERS = _env_int('TCAT_WORKERS', 4)

# Roughly one obsidian call in a few hundred wedges and never returns, at the same
# rate whether we read serially or concurrently. The wedge is per-invocation — the app
# keeps answering everything else — so a short deadline plus a fresh call is the cure.
# A healthy call takes ~10ms (20ms worst of 320 measured), so 1s is ~100x headroom and
# keeps a stall inside the second this tool should always finish in. A merely slow call
# is not lost by a tight deadline: the retry catches it.
OBSIDIAN_TIMEOUT  = _env_int('TCAT_TIMEOUT', 1)   # seconds per call
OBSIDIAN_ATTEMPTS = 3
SLOW_NOTICE_AFTER = 2.5     # seconds before telling the user we're waiting, not hung
DEBUG = bool(os.environ.get('TCAT_DEBUG'))

_lines_cache = {}

def die(msg):
    """Report a fatal error and leave immediately. os._exit() because a wedged
    obsidian call can leave a pool thread blocked, and a normal exit would hang
    joining it."""
    sys.stdout.flush()
    sys.stderr.write(f"tcat: {msg}\n")
    sys.stderr.flush()
    os._exit(2)

def _on_uncaught(exc_type, exc, tb):
    """Ctrl-C should leave at once — without a traceback, and without waiting on
    reader threads that may be stuck on a slow obsidian call."""
    if issubclass(exc_type, KeyboardInterrupt):
        sys.stdout.flush()
        sys.stderr.write('\ntcat: interrupted\n')
        sys.stderr.flush()
        os._exit(130)
    sys.__excepthook__(exc_type, exc, tb)

sys.excepthook = _on_uncaught

def _run_obsidian(file_path):
    """Return the raw markdown lines of one vault file, retrying a failure that might
    be transient. Raises ObsidianError once the attempts are spent."""
    for attempt in range(1, OBSIDIAN_ATTEMPTS + 1):
        try:
            return _obsidian_once(file_path)
        except ObsidianError as e:
            if not e.retry or attempt == OBSIDIAN_ATTEMPTS:
                raise
            if e.stalled:
                sys.stderr.write(f"tcat: obsidian stalled on {file_path}, retrying\n")

def _obsidian_once(file_path):
    """One `obsidian read` call. Raises ObsidianError if the CLI is missing or its
    output isn't something we can trust.

    `read` rather than `tasks`: the flat task list `tasks` returns has already
    thrown away the headings, and the ladder markers under ### *Actio* are the only
    thing that says which of a weekly note's tasks are the week's plan. tcat has
    always read raw markdown for that reason; this is the seam where the two tools
    stopped disagreeing about what a note contains."""
    argv = ['obsidian', 'read', f'file={file_path}']
    started = time.monotonic()
    try:
        # stdin is closed: this is never an interactive call, and a CLI that decided
        # to read from the terminal would block every reader thread behind it.
        result = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True,
                                text=True, timeout=OBSIDIAN_TIMEOUT)
    except FileNotFoundError:
        raise ObsidianError(
            "the 'obsidian' CLI was not found on PATH — tcat reads the vault through it",
            retry=False,
        )
    except subprocess.TimeoutExpired:
        raise ObsidianError(
            f"'obsidian read file={file_path}' produced nothing within "
            f"{OBSIDIAN_TIMEOUT}s on {OBSIDIAN_ATTEMPTS} attempts — is Obsidian running "
            f"with the vault open? (TCAT_TIMEOUT=N raises the limit)",
            stalled=True,
        )
    except OSError as e:
        raise ObsidianError(f"could not run 'obsidian': {e}")

    if DEBUG:
        sys.stderr.write(f"tcat: {time.monotonic() - started:6.3f}s  {file_path}\n")

    out, err = result.stdout, result.stderr.strip()
    if result.returncode != 0:
        detail = err or out.strip()
        first = detail.splitlines()[0] if detail else '(no output)'
        raise ObsidianError(f"'obsidian read file={file_path}' exited {result.returncode}: {first}")

    lines = out.splitlines()
    if not lines:
        # An empty note is a legitimately empty side, the same as a missing one.
        return []
    # Only the *first* line can be an error report. Scanning them all was safe while
    # this read a task list; on raw markdown a note that happens to open a line with
    # "Error:" would be misread as a failed read.
    first = lines[0].strip()
    if _MISSING_FILE_RE.match(first):
        return []
    if first.startswith('Error:'):
        raise ObsidianError(f"obsidian could not read {file_path!r}: {first}")
    if not out.strip() and err:
        raise ObsidianError(f"obsidian returned nothing for {file_path!r}: {err.splitlines()[0]}")
    return lines

def obsidian_lines(file_path):
    """Memoized markdown lines for one vault file."""
    if file_path not in _lines_cache:
        try:
            _lines_cache[file_path] = _run_obsidian(file_path)
        except ObsidianError as e:
            die(str(e))
    return _lines_cache[file_path]

def prefetch(paths):
    """Warm the line cache for several vault files at once. Each obsidian call is
    mostly waiting on the app, so overlapping them is a win for week modes.

    `read` returns a whole note where `tasks` returned a handful of lines, so each
    payload is larger — but the call count is unchanged, and the wait was always
    the round trip rather than the bytes."""
    todo = [p for p in dict.fromkeys(paths) if p not in _lines_cache]
    if not todo:
        return
    # Named slow_timer, not notice: notice() is the deferred-message function, and a
    # local of that name here would shadow it for the whole body.
    slow_timer = threading.Timer(SLOW_NOTICE_AFTER, sys.stderr.write,
                                 (f"tcat: waiting on obsidian ({len(todo)} files)…\n",))
    slow_timer.daemon = True
    slow_timer.start()
    try:
        if FETCH_WORKERS < 2 or len(todo) < 2:
            for p in todo:
                obsidian_lines(p)
            return
        # Both branches go through obsidian_lines() so the vault read has exactly one
        # seam. Submitting _run_obsidian directly used to leave the memo wrapper
        # bypassed on the concurrent path — a second entry point that anything hooking
        # the read would silently miss.
        with ThreadPoolExecutor(max_workers=min(FETCH_WORKERS, len(todo))) as ex:
            for p in todo:
                ex.submit(obsidian_lines, p)
    finally:
        slow_timer.cancel()

TASK_RE = re.compile(r'^(\s*)- (\[.\]) (.+)$')
H2_RE   = re.compile(r'^##\s+\*(\w+)\*')
H3_RE   = re.compile(r'^###\s+\*(\w+)\*')
MARK_RE = re.compile(r'^\*{2,3}([a-z]+)\*{2,3}\s*$')
MDLINK_RE = re.compile(r'\[([^\[\]]+)\]\([^()]*\)')

# The weekly day ladder. A whitelist, never a blacklist — the weekly template
# gains sections over time, and this is what keeps Ratio's **rationes** lines and
# Mensis's prospect checkboxes out of every day.
#
# WEEK_DAYS is the ladder's day span on its own: -A asks for all seven at once,
# and deriving LADDER from it keeps the two from drifting apart.
WEEK_DAYS = ('sunday', 'monday', 'tuesday', 'wednesday',
             'thursday', 'friday', 'saturday')
LADDER = ('promissum',) + WEEK_DAYS + ('future',)

def clean_text(s):
    """Un-escape Obsidian's bracket escapes, drop a trailing ' – ...' section suffix,
    then shorten wikilink paths and reduce markdown links to their display text.

    **The order is the whole point, and it diverges from tcat.** `strip_section_suffix`
    only skips a dash it can see is inside brackets, so it has to run while the
    brackets are still there. tcat reduces links first, which leaves
    `[[marc randolph on building netflix – tim ferriss (496)]]` looking like prose with
    a section suffix and truncates it at the dash — 18 of 455 names in this vault, some
    down to a third of their length. Un-escaping stays first either way, or `\\[\\[foo]]`
    never registers as bracket depth at all.

    Wikilinks keep their brackets (`normalize_wikilinks` only shortens the path), which
    is the second divergence: tdiff has always displayed `complete [[2026-W28]]`, and a
    name is a name whether or not the vault happened to link it. Markdown links do get
    reduced — that part is new, and without it a name carries a full URL.
    """
    s = s.replace('\\[', '[').replace('\\]', ']')
    s = strip_section_suffix(s)
    s = normalize_wikilinks(s)
    return MDLINK_RE.sub(lambda m: m.group(1), s)

def parse_note(lines, region=None, day=None, routines=False, skip_future=False):
    """Yield (indent, status_char, name, seq) for tasks in a note.

    Fence-agnostic by design: ``` lines are ignored, never toggled. The weekly
    note's whole Fixa section is itself fenced, so toggling desynchronises. Every
    `base`/`dataviewjs` block lives under ## *Recensio*, ahead of ### *Actio*.

    region/day: when both are given, only tasks under that ### heading and that
    ladder marker are yielded (weekly mode). `day` takes one marker name or a
    tuple of them — WEEK_DAYS folds the whole week into one pass, which is what
    -A -P wants. When neither is given, every task in the note is yielded (daily
    mode).

    skip_future: drop tasks sitting under a **future** marker. Only -A passes it.
    A daily note's future bucket is fair to show for that one day, but aggregating
    a week would fold deferred work in alongside what actually happened — and a
    pre-split Sunday's bucket holds a whole week of it.
    """
    days = (day,) if isinstance(day, str) else day
    cur_region = cur_day = None
    seq = 0
    for line in lines:
        if H2_RE.match(line):
            cur_region = cur_day = None
            continue
        m = H3_RE.match(line)
        if m:
            cur_region = m.group(1).lower()
            cur_day = None
            continue
        m = MARK_RE.match(line)
        if m and m.group(1) in LADDER:
            # Once inside **future**, stay there: a future fence may carry its own
            # **sunday**/**other** markers that must not re-enter the ladder.
            if cur_day != 'future':
                cur_day = m.group(1)
            continue
        m = TASK_RE.match(line)
        if not m:
            continue
        if not routines and '#routine' in line:
            continue
        if skip_future and cur_day == 'future':
            continue
        if region is not None and (cur_region != region or cur_day not in days):
            continue
        seq += 1
        yield len(m.group(1)), m.group(2)[1], clean_text(m.group(3)), seq

_HEAD_RE = re.compile(r'^#{1,6}\s')

def extract_section(lines, name):
    """Return one ### section's body verbatim, or None if the heading is absent.

    The body runs from the heading to the next heading of any level. Leading and
    trailing blank lines are stripped; everything else is untouched — no link
    cleaning, no comment stripping, no section-suffix trimming. A heading with an
    empty body returns '', which is what tells 'no such section' apart from
    'nothing written there yet'.

    Fence-agnostic like parse_note(): ``` lines are ignored. Safe here because
    ### *Missio* carries prose only — every fenced block in the weekly note
    (base/dataviewjs/markdown) lives under ## *Recensio* or ### *Fixa*.
    """
    body, inside = [], False
    for line in lines:
        if inside:
            if _HEAD_RE.match(line):
                break
            body.append(line)
            continue
        m = H3_RE.match(line)
        if m and m.group(1).lower() == name:
            inside = True
    if not inside:
        return None
    while body and not body[0].strip():
        body.pop(0)
    while body and not body[-1].strip():
        body.pop()
    return '\n'.join(body)

# ── Grouping ──────────────────────────────────────────────────────────────────

def build_groups(note_records):
    """Fold per-note (indent, status, name, seq) records into an ordered structure.

    Takes one list per note, not one flat stream. `current` resets at every note
    boundary, so a project header left open at the end of one note cannot adopt the
    indented tasks at the start of the next — which a week read of eight notes would
    otherwise do, silently. `index` deliberately does *not* reset: a project named in
    several notes is still one merged group.

    Returns a list of (status, name, children, seq) where children is a list of
    (status, name, seq); a bare task has children == None. Groups merge
    case-insensitively because one note may write both [[Project Alpha]] and
    [[project alpha]], and block markers are hidden, so five identical headers would
    be noise.

    A bare task keeps its seq because it still has to be deduped, and dedup picks the
    winner by page position. A group header's seq is None: a header is never
    clustered, and a merged group has several of them anyway.
    """
    tops, index = [], {}
    for records in note_records:
        current = None
        for indent, status, name, seq in records:
            if status in PROJECT_STATUSES and indent == 0:
                key = name.lower()
                if key in index:
                    current = index[key]
                else:
                    current = [status, name, [], None]
                    index[key] = current
                    tops.append(current)
                continue
            if indent > 0 and current is not None:
                current[2].append((status, name, seq))
            else:
                current = None
                tops.append([status, name, None, seq])
    return tops

def dedup(items):
    """Reduce (status, name, seq) triples to one (status, name) per logical task.

    A cluster's *last* member decides the status: within one note the last statement is
    the current one, and across a week the last note to mention a task has the latest
    word on it. `seq` says which member that is, which is why it survives even though
    nothing downstream reads a position any more.
    """
    if not items:
        return []
    clusters = cluster_records([(n, s, q) for s, n, q in items])
    tasks, order = materialize(clusters)
    return [(tasks[n], n) for n in order]

def sort_key(status, name):
    return (display_rank(status), name.lower())

def order_rows(rows):
    """Sort rows by [order].statuses rank, then name. Every level of every view goes
    through here — grouped tops and project children alike — so the two cannot drift
    apart the way the old --flat sort had silently drifted from the grouped one."""
    rows.sort(key=lambda r: sort_key(r[0], r[1]))

# ── Argument parsing ──────────────────────────────────────────────────────────

parser = argparse.ArgumentParser(
    prog='tcat',
    description="Show what is in an Obsidian note: one day's tasks, or a whole week's.",
    epilog=(
        'A date names a day, a w## names a week, and a week has two sources you can '
        'narrow to. Dates accept YYYY-MM-DD, "today", "yesterday", "tomorrow", "0" '
        '(today), -N / +N (e.g. -1 for yesterday), or a weekday name (monday..sunday, '
        'or mon..sun), which resolves to its most recent occurrence at or before today. '
        'Weeks accept w## / w2026-W## (e.g. w30), or w0 / w-1 / w+1 relative to this '
        'week. tdiff accepts exactly the same set — the resolver is shared code.'
    ),
)
parser.add_argument('date', nargs='?', default='today',
                    help='the day or week to show (default: today)')
# The positional picks the scope; -D/-W pick the source. A week has two of them, so
# naming neither reads both — which is why naming both would be a second spelling of
# the default, and why they are mutually exclusive.
_source_flags = parser.add_mutually_exclusive_group()
_source_flags.add_argument('-D', '--dailies', action='store_true',
                    help="read only daily notes: on a w##, the week's seven; on a date, "
                         'the daily note, which is already the default')
_source_flags.add_argument('-W', '--weekly',  action='store_true',
                    help="read only the weekly note's ### *Actio*: on a date, that "
                         "weekday's allocation; on a w##, the whole week's plan")
parser.add_argument('--missio',         action='store_true',
                    help="show the week's mission — the weekly note's ### *Missio* "
                         "section, verbatim — instead of any tasks")
parser.add_argument('-S', '--status',   type=str, default=None,
                    help="show only tasks whose status is in the given set "
                         "(concatenated chars, e.g. 'x-#'); prefix '^' to invert "
                         "(e.g. '^x'). Overrides hidden statuses. Bare '-S -' looks "
                         "like a flag to argparse; use -S=- or quote in a set ('x-')")
parser.add_argument('-I', '--ignore',   action='store_true',
                    help='hide settled tasks — the statuses named by [roles] settled '
                         '(done, cancelled, overrun, postponed, advanced) — leaving only '
                         'what is still open. Composes with -S, which wins for any '
                         'status it names outright')
parser.add_argument('--routines',       action='store_true', help='include #routine tasks')
parser.add_argument('--json',           action='store_true', help='machine-readable output')
parser.add_argument('--no-color',       action='store_true', help='disable colored output')
parser.add_argument('--no-summary',     action='store_true', help='suppress the summary line')
parser.add_argument('--config',         type=str, default=None,
                    help='additional (merging) config layer, applied last; the layers '
                         'below it are ~/.config/obsidian-tasks/statuses.toml, '
                         '~/.config/tcat/config.toml, then $TCAT_CONFIG')

# argparse chokes on bare negative numbers like -1 before we can process them;
# intercept them and turn them into a safe token first.
raw = sys.argv[1:]
safe = [('__NEG__' + a[1:]) if re.fullmatch(r'-\d+', a) else a for a in raw]
args = parser.parse_args(safe)

load_config(args.config, parser.error)

# No config is a valid state, not an error: tcat runs with everything unranked and
# uncoloured rather than inventing ranks the user never chose. It just says so.
if not CONFIG_FOUND:
    notice('no status config found — showing unranked and uncoloured.\n'
           '      see statuses.example.toml and config.example.toml')

def restore(s):
    if s.startswith('__NEG__'):
        return '-' + s[7:]
    return s

_ISO_RE = re.compile(r'\d{4}-\d{2}-\d{2}')
_OFF_RE = re.compile(r'([-+])(\d+)')

# One line each so tools/check-core-sync.sh, which compares constants by their
# assignment line, actually covers them. Both the full name and its 3-letter prefix
# map to the same index.
_WEEKDAY_NAMES = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday']
WEEKDAYS = {n[:k]: i for i, n in enumerate(_WEEKDAY_NAMES) for k in (3, len(n))}

def resolve_date(s):
    today = date.today()
    if s in ('today', '0'):
        return today.isoformat()
    if s == 'yesterday':
        return (today - timedelta(days=1)).isoformat()
    if s == 'tomorrow':
        return (today + timedelta(days=1)).isoformat()
    low = s.lower()
    if low in WEEKDAYS:
        # Backwards: the most recent occurrence at or before today. A future day
        # has no tasks yet, so resolving forwards would always come back empty.
        days_back = (today.weekday() - WEEKDAYS[low]) % 7
        return (today - timedelta(days=days_back)).isoformat()
    m = _OFF_RE.fullmatch(s)
    if m:
        n = int(m.group(2))
        if n < 1:
            parser.error(f"invalid date: {s!r} (use 0 for today)")
        delta = -n if m.group(1) == '-' else n
        return (today + timedelta(days=delta)).isoformat()
    if _ISO_RE.fullmatch(s):
        try:
            return date.fromisoformat(s).isoformat()
        except ValueError:
            parser.error(f"invalid date: {s!r}")
    parser.error(
        f"invalid date: {s!r} (expected YYYY-MM-DD, 'today', 'yesterday', "
        f"'tomorrow', '0', -N/+N, a weekday name, or w##)"
    )

# A week mode is anything whose subject is the week rather than one day.
# w30 / w-1 / w2026-W30 name a week; anything else names a day. That is the whole
# scope rule — -D/-W then pick which of a week's two sources to read.
raw_date = restore(args.date)
week_arg = resolve_week_label(raw_date)

if args.missio and (args.dailies or args.weekly):
    parser.error('--missio already reads the weekly note; -D/-W have nothing to narrow')

if week_arg:
    target_d = _week_label_to_sunday(week_arg)
    # Not every YYYY-W## string is a week. Labels are named for the year a week
    # ends in, so `2026-W53` maps onto a Sunday whose week is really 2027-W01 —
    # a phantom that would otherwise be read as if it were real. Round-tripping
    # the label through week_span() is what catches it. A relative label needs no
    # check: it came out of week_span() in the first place.
    real_label = week_span(target_d)[2]
    if real_label != week_arg:
        parser.error(f"{raw_date} is not a week in this calendar "
                     f"(that Sunday belongs to {real_label}); did you mean w{real_label}?")
    target = target_d.isoformat()
else:
    target = resolve_date(raw_date)
    target_d = date.fromisoformat(target)

# Only the daily note is bound to a day that has already happened. The weekly note may
# well be written ahead of the week, so -W and any w## are free to look forward.
if target_d > date.today() and not (args.weekly or week_arg):
    parser.error(
        f"{target} is in the future; a daily note won't exist yet. "
        f"Use -W to read the weekly note's allocation for that day."
    )

status_filter = None
if args.status is not None:
    v = restore(args.status)
    negate = v.startswith('^')
    if negate:
        v = v[1:]
    chars = set(v)
    if not chars:
        parser.error("--status expects at least one status char (e.g. 'x-#' or '^x')")
    status_filter = (chars, negate)

# Same contract as [order].statuses: no built-in table, so an unconfigured -I
# filters nothing rather than inventing a set of statuses to call settled.
if args.ignore and not SETTLED_STATUSES:
    notice('-I: no [roles] settled in config — nothing to hide')

def status_match(ch):
    """Is this status visible?

    Three filters can suppress a status: [roles] hide (config, always on), -I
    (settled work), and -S (an explicit set). They compose, except that -S wins
    outright for any status it names — asking for something by name is the
    strongest possible statement that you want to see it.
    """
    if status_filter is not None:
        chars, negate = status_filter
        # A positive -S names exactly what it wants, so it overrides both `hide`
        # and -I: `-I -S x` is a request to see done tasks, not a contradiction.
        if not negate:
            return ch in chars
        if ch in chars:
            return False
        # A negated -S only names what to drop. It still overrides `hide` for
        # everything it didn't name, but -I is an explicit flag on the same
        # command line, so it keeps applying to the remainder.
        return not (args.ignore and ch in SETTLED_STATUSES)
    return (ch not in HIDDEN_STATUSES
            and not (args.ignore and ch in SETTLED_STATUSES))

# ── Colors ────────────────────────────────────────────────────────────────────

def _sgr(spec):
    """'#rrggbb' -> 24-bit SGR foreground. Returns '' for anything unusable."""
    s = str(spec).strip().lstrip('#')
    if len(s) != 6:
        return ''
    try:
        r, g, b = (int(s[i:i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        return ''
    return f'\033[38;2;{r};{g};{b}m'

def _pick_theme():
    """Which palette to use.

    Terminals don't reliably report their background colour, so an env var settles
    it: $TCAT_THEME, else the COLORFGBG most terminals set, else dark. Querying via
    OSC 11 would need raw-tty mode and a stdin round-trip — and stdin handling here
    is already delicate enough to require stdin=DEVNULL on every subprocess call
    (see _read_uncached), so it isn't worth the fragility.
    """
    t = os.environ.get('TCAT_THEME', '').strip().lower()
    if t in ('light', 'dark'):
        return t
    fgbg = os.environ.get('COLORFGBG', '')
    if ';' in fgbg:
        bg = fgbg.rsplit(';', 1)[-1].strip()
        # The conventional reading: 7 and 9-15 are light background slots, 8 is not.
        if bg.isdigit():
            return 'light' if int(bg) >= 7 and int(bg) != 8 else 'dark'
    return 'dark'

use_color = not args.no_color and not args.json and sys.stdout.isatty()
DIM   = '\033[2m' if use_color else ''
RESET = '\033[0m' if use_color else ''

THEME = _pick_theme()
STATUS_SGR = {}          # char -> SGR escape; absent means default foreground
if use_color:
    for _ch, _hex in THEMES.get(THEME, {}).items():
        _esc = _sgr(_hex)
        if _esc:
            STATUS_SGR[_ch] = _esc
        else:
            notice(f'ignoring unusable colour {_hex!r} for status {_ch!r}')

# ── Rendering ─────────────────────────────────────────────────────────────────

def row(status, name, indent):
    """One task line.

    Only the status marker is coloured — a wall of tinted prose is harder to read
    than a column of tinted markers. The brackets are coloured along with the
    symbol: `[x]` is one glyph to the eye, and tinting only the char inside it
    leaves the marker looking half-lit rather than deliberate.

    The exception is `full_row` (done, cancelled): those take the colour across
    the whole line, so grey carries two distinct signals — a grey marker means
    deprioritised but open, a grey line means settled.
    """
    c = STATUS_SGR.get(status, '')
    if not c:
        return f'{indent}[{status}] {name}'
    if status in FULL_ROW:
        return f'{indent}{c}[{status}] {name}{RESET}'
    return f'{indent}{c}[{status}]{RESET} {name}'

def footer(contents, mode, note_field):
    """The one line of context, always `contents · mode · file(s)`."""
    return f'  {DIM}' + '  ·  '.join([contents, mode, note_field]) + RESET

def flush_notices():
    for m in NOTICES:
        print(f'tcat: {m}', file=sys.stderr)

def finish(code=0):
    """Exit, flushing notices first. --json and --no-summary both mean 'output with
    nothing around it', so neither gets them."""
    if not (args.json or args.no_summary):
        flush_notices()
    sys.exit(code)

def report_unlisted(statuses):
    """Flag statuses that appeared in a note but are absent from [order].statuses.

    They still render — unranked, at the bottom, uncoloured — but silently doing so
    would look like a sort bug rather than a gap in the config.
    """
    if not CONFIG_FOUND:
        return
    missing = sorted(s for s in statuses if s not in DISPLAY_ORDER)
    if missing:
        shown = ' '.join(f'[{s}]' for s in missing)
        notice(f'not in [order].statuses, so shown last and uncoloured: {shown}')

# ── Load ──────────────────────────────────────────────────────────────────────

WEEKDAY_NAME = ['monday', 'tuesday', 'wednesday', 'thursday',
                'friday', 'saturday', 'sunday'][target_d.weekday()]
week_sun, _, week_label = week_span(target_d)

WEEKLY_NAME = f'{WEEKLY_FOLDER}/{week_label}' if WEEKLY_FOLDER else week_label

def daily_name(d):
    return f'{DAILY_FOLDER}/{d}' if DAILY_FOLDER else d

# ── Missio ────────────────────────────────────────────────────────────────────
#
# Standalone: the week's mission is prose, not tasks, so this branch reads the
# weekly note, prints, and exits before any of the task machinery is consulted.
if args.missio:
    lines = obsidian_lines(WEEKLY_NAME)
    # obsidian_lines returns [] for a missing note, and extract_section returns None
    # for a note with no such heading — so the missing-file guard is redundant.
    body = extract_section(lines, 'missio')
    body = body or None      # '' (heading present, nothing written) reads as absent

    if args.json:
        print(json.dumps({'week': week_label, 'missio': body},
                         ensure_ascii=False, indent=2))
        finish()

    if body:
        for line in body.split('\n'):
            print(f'  {line}' if line.strip() else '')
    elif not args.no_summary:
        print(f'  {DIM}nothing to show{RESET}')
    if not args.no_summary:
        # Prose isn't countable, but every mode keeps all three footer fields so
        # the shape never changes: contents · mode · file.
        print()
        print(footer('text', 'missio', week_label))
    finish()

# ── Read plan ─────────────────────────────────────────────────────────────────
#
# One ordered list of (note, parse kwargs), built from the scope the positional named
# and the source -D/-W asked for. Everything downstream reads it, so there is exactly
# one place that decides what a given invocation opens.

# A single day read on its own keeps its **future** bucket — deferring something is
# part of that day. Folded into a week it goes, or a pre-split Sunday's bucket drags a
# whole week of deferred work in beside what actually happened.
DAY_KW        = {}
WEEK_DAY_KW   = {'skip_future': True}
# A whole week's plan takes the unallocated tasks too: `None` leads the whitelist and
# catches everything under ### *Actio* that never got a **weekday** marker. On an
# organised week it matches nothing; on a week still being drafted it is the entire
# plan — 2026-W34 currently holds 37 such tasks and 0 allocated ones. A single day is
# the opposite question, "what did I put on Monday", so it asks for the marker alone.
WEEK_PLAN_KW  = {'region': 'actio', 'day': (None,) + WEEK_DAYS}

if week_arg:
    entries = []
    # The weekly note leads. materialize() keeps the last occurrence in page order and
    # seq climbs across notes, so reading the plan first is what lets every daily's
    # statement beat it — the same precedence tdiff gets by giving the weekly note
    # day_index 0 so it loses every tie.
    if not args.dailies:
        entries.append((WEEKLY_NAME, WEEK_PLAN_KW))
    if not args.weekly:
        entries += [(daily_name((week_sun + timedelta(days=i)).isoformat()), WEEK_DAY_KW)
                    for i in range(7)]
else:
    entries = ([(WEEKLY_NAME, {'region': 'actio', 'day': WEEKDAY_NAME})] if args.weekly
               else [(daily_name(target), DAY_KW)])

prefetch([n for n, _ in entries])

# Grouped per note, because build_groups() must not let a project header left open at
# the end of one note adopt the indented tasks at the start of the next.
note_records, notes_read, seq0 = [], [], 0
for name, kw in entries:
    lines = obsidian_lines(name)
    # A missing day is ordinary — this vault averages six notes in seven — so a gap is
    # skipped and counted, never an error.
    if not lines:
        continue
    notes_read.append(name)
    recs = list(parse_note(lines, routines=args.routines, **kw))
    # parse_note restarts seq at 1 every call, so the offset is applied here and
    # advanced by what the note actually yielded. Drop it and "last in page order"
    # quietly becomes "last in whichever note".
    note_records.append([(i, s, n, seq0 + q) for i, s, n, q in recs])
    seq0 += len(recs)

dailies_read = sum(1 for n in notes_read if n != WEEKLY_NAME)
if week_arg:
    source = week_label
    if args.weekly:
        mode, note_field = 'week plan', week_label
    elif args.dailies:
        mode, note_field = 'week dailies', f'{week_label} ({dailies_read}/7 dailies)'
    else:
        mode = 'week'
        seen_weekly = ', weekly' if WEEKLY_NAME in notes_read else ''
        note_field = f'{week_label} ({dailies_read}/7 dailies{seen_weekly})'
elif args.weekly:
    source = week_label
    # The weekly note is what gets read, so it — not the invoked day — is the file
    # this output came from.
    mode, note_field = 'plan', week_label
else:
    source = 'daily'
    mode, note_field = 'daily', target

# ── Assemble ──────────────────────────────────────────────────────────────────

# (status, name, children) — children None for a bare task. Output is always grouped
# and always ordered by [order].statuses then name; structure and order stopped being
# flags because neither had a second setting worth keeping.
#
# Dedup is scoped, and the scopes never merge into one another: every project's
# children collapse among themselves, and the bare tasks collapse among themselves.
# So a task written under two projects keeps a row under each — the header is real
# context — and a bare occurrence never swallows a project's copy. Bare tasks are
# collected rather than emitted inline because dedup needs the whole scope at once.
rows = []
bare = []
for status, name, children, _ in build_groups(note_records):
    if children is None:
        bare.append((status, name, _))
        continue
    kids = [k for k in dedup(children) if status_match(k[0])]
    order_rows(kids)
    # A project whose every child was filtered out is not worth a header.
    if kids:
        rows.append((status, name, kids))
for status, name in dedup(bare):
    if status_match(status):
        rows.append((status, name, None))
order_rows(rows)

# ── Output ────────────────────────────────────────────────────────────────────

if args.json:
    json_rows = []
    for _s, _n, _k in rows:
        if _k is None:
            json_rows.append({'status': _s, 'name': _n})
            continue
        # A project header is context, not work: it survives as the `project` key on
        # its children rather than as a row of its own. Same as tdiff.
        for _cs, _cn in _k:
            json_rows.append({'status': _cs, 'name': _cn, 'project': _n})
    print(json.dumps({
        'mode': mode,
        'date': target,
        # A week spans seven days, so no single weekday describes the payload.
        'weekday': None if week_arg else WEEKDAY_NAME,
        'week': week_label,
        'files': notes_read,
        # Flat, with the project named on each row rather than nested children —
        # tdiff's shape, so a consumer reading both tools learns one vocabulary.
        # Grouping stays a rendering concern.
        'rows': json_rows,
    }, ensure_ascii=False, indent=2))
    finish()

leaves = 0
seen_statuses = set()
for status, name, kids in rows:
    seen_statuses.add(status)
    print(row(status, name, '  '))
    if kids is None:
        leaves += 1
        continue
    for cs, cn in kids:
        seen_statuses.add(cs)
        print(row(cs, cn, '      '))
        leaves += 1

if not rows:
    if not args.no_summary:
        print(f"  {DIM}nothing to show{RESET}")
    finish()

report_unlisted(seen_statuses)

if not args.no_summary:
    groups = sum(1 for _, _, k in rows if k is not None)
    contents = f"{leaves} task" + ('' if leaves == 1 else 's')
    if groups:
        # Projects join `contents` rather than taking a field of their own, so the
        # footer is always exactly three fields wide.
        contents += f", {groups} project" + ('' if groups == 1 else 's')
    print()
    print(footer(contents, mode, note_field))

finish()
