def restore(s):
    if s.startswith('__NEG__'):
        return '-' + s[7:]
    return s

_ISO_RE = re.compile(r'\d{4}-\d{2}-\d{2}')
_OFF_RE = re.compile(r'([-+])(\d+)')

WEEKDAYS = {n: i for i, n in enumerate(
    ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'])}
WEEKDAYS.update({n[:3]: i for n, i in list(WEEKDAYS.items())})

def resolve_date(s):
    today = date.today()
    if s in ('today', '0'):
        return today.isoformat()
    if s == 'yesterday':
        return (today - timedelta(days=1)).isoformat()
    if s == 'tomorrow':
        return (today + timedelta(days=1)).isoformat()
    low = s.lower()
    if low in WEEKDAYS:
        # Backwards: the most recent occurrence at or before today. A future day
        # has no tasks yet, so resolving forwards would always come back empty.
        days_back = (today.weekday() - WEEKDAYS[low]) % 7
        return (today - timedelta(days=days_back)).isoformat()
    m = _OFF_RE.fullmatch(s)
    if m:
        n = int(m.group(2))
        if n < 1:
            parser.error(f"invalid date: {s!r} (use 0 for today)")
        delta = -n if m.group(1) == '-' else n
        return (today + timedelta(days=delta)).isoformat()
    if _ISO_RE.fullmatch(s):
        try:
            return date.fromisoformat(s).isoformat()
        except ValueError:
            parser.error(f"invalid date: {s!r}")
    parser.error(
        f"invalid date: {s!r} (expected YYYY-MM-DD, 'today', 'yesterday', "
        f"'tomorrow', '0', -N/+N, a weekday name, or w##)"
    )

# A week mode is anything whose subject is the week rather than one day.
week_mode = args.all_week or args.missio

# w30 / w2026-W30 name a week, not a day. There is no sensible single-day reading
# of one, and guessing between "the week's tasks" and "the week's plan" would be
# worse than asking.
raw_date = restore(args.date)
week_arg = resolve_week_label(raw_date)
if week_arg and not week_mode:
    parser.error(
        f"{raw_date} names a week; add -A for its tasks, -A -P for its plan, "
        f"or --missio for its mission"
    )

if args.week_offset is not None:
    if not week_mode:
        parser.error("-w/--week-offset only applies to -A or --missio")
    if week_arg:
        parser.error(f"cannot combine -w/--week-offset with {raw_date} — "
                     f"both name a week")
    try:
        week_offset = int(restore(args.week_offset))
    except ValueError:
        parser.error(f"-w/--week-offset expects an integer, got {args.week_offset!r}")
else:
    week_offset = 0

if week_arg:
    target_d = _week_label_to_sunday(week_arg)
    target = target_d.isoformat()
else:
    target = resolve_date(raw_date)
    target_d = date.fromisoformat(target) + timedelta(days=week_offset * 7)
    target = target_d.isoformat()

# Only the daily note is bound to a past date; every week mode may well have
# something written for a week that hasn't arrived yet.
if target_d > date.today() and not (args.plan or week_mode):
    parser.error(
        f"{target} is in the future; a daily note won't exist yet. "
        f"Use -P to read the weekly plan's allocation for that day."
    )

status_filter = None
if args.status is not None:
    v = restore(args.status)
    negate = v.startswith('^')
    if negate:
        v = v[1:]
    chars = set(v)
    if not chars:
        parser.error("--status expects at least one status char (e.g. 'x-#' or '^x')")
    status_filter = (chars, negate)

def status_match(ch):
    if status_filter is None:
        return ch not in HIDDEN_STATUSES
    chars, negate = status_filter
    return (ch not in chars) if negate else (ch in chars)

# ── Colors ────────────────────────────────────────────────────────────────────

use_color = not args.no_color and sys.stdout.isatty()
CYAN   = '\033[36m' if use_color else ''
DIM    = '\033[2m'  if use_color else ''
BOLD   = '\033[1m'  if use_color else ''
RESET  = '\033[0m'  if use_color else ''

# ── Load ──────────────────────────────────────────────────────────────────────

WEEKDAY_NAME = ['monday', 'tuesday', 'wednesday', 'thursday',
                'friday', 'saturday', 'sunday'][target_d.weekday()]
week_sun, _, week_label = week_span(target_d)

WEEKLY_NAME = f'{WEEKLY_FOLDER}/{week_label}' if WEEKLY_FOLDER else week_label

def daily_name(d):
    return f'{DAILY_FOLDER}/{d}' if DAILY_FOLDER else d

# ── Missio ────────────────────────────────────────────────────────────────────
#
# Standalone: the week's mission is prose, not tasks, so this branch reads the
# weekly note, prints, and exits before any of the task machinery is consulted.
if args.missio:
    lines = read_note(WEEKLY_NAME)
    body, reason = None, None
    if lines is None:
        reason = f"no note found for '{WEEKLY_NAME}'"
    else:
        body = extract_section(lines, 'missio')
        if body is None:
            reason = f'{week_label} has no ### *Missio* section'
        elif not body:
            reason = f"{week_label}'s Missio is empty"
            body = None

    if args.json:
        print(json.dumps({'week': week_label, 'missio': body},
                         ensure_ascii=False, indent=2))
        sys.exit(0)

    print(f'{BOLD}{week_label}{RESET}')
    print()
    if body:
        for line in body.split('\n'):
            print(f'  {line}' if line.strip() else '')
    elif reason and args.verbose:
        print(f'  {DIM}{reason}{RESET}')
    elif not args.no_summary:
        print(f'  {DIM}nothing to show{RESET}')
    sys.exit(0)

reason = None
records = []
notes_read = []

# ── The whole week, actually done ─────────────────────────────────────────────
#
# -A without -P is the week-scale counterpart of a bare date: the seven daily
# notes, merged. Missing days are ordinary — this vault averages six of seven —
# so a gap is skipped and counted, never an error.
if args.all_week and not args.plan:
    source = 'daily'
    week_names = [daily_name((week_sun + timedelta(days=i)).isoformat())
                  for i in range(7)]
    prefetch(week_names)
    seq0 = 0
    for name in week_names:
        lines = read_note(name)
        if lines is None:
            continue
        notes_read.append(name)
        # Page order across the seven notes is what makes dedup pick the latest
        # day's status, so seq has to keep climbing between notes rather than
        # restarting at 0 for each one.
        recs = list(parse_note(lines, routines=args.routines, skip_future=True))
        records += [(i, s, n, seq0 + q) for i, s, n, q in recs]
        seq0 += len(recs)
    if not records:
        if not notes_read:
            reason = f'no daily notes found for {week_label}'
        else:
            reason = (f"{week_label}'s {len(notes_read)} daily note"
                      f"{'' if len(notes_read) == 1 else 's'} hold no tasks")
    lines = True     # the empty-output path below only checks for a missing note

else:
    if args.plan or args.all_week:
        note_name = WEEKLY_NAME
        source = week_label
    else:
        note_name = daily_name(target)
        source = 'daily'

    lines = read_note(note_name)
    if lines is not None:
        notes_read.append(note_name)

    if lines is None:
        reason = f"no note found for '{note_name}'"
    elif args.plan or args.all_week:
        records = list(parse_note(lines, region='actio',
                                  day=WEEK_DAYS if args.all_week else WEEKDAY_NAME,
                                  routines=args.routines))
        if not records:
            present, n_tasks, markers = survey_region(lines, 'actio')
            days_seen = markers - {'promissum', 'future'}
            if not present:
                reason = f"{week_label} has no ### *Actio* section"
            elif n_tasks and not days_seen:
                reason = (f"{week_label} predates the day ladder: its Actio holds "
                          f"{n_tasks} task{'' if n_tasks == 1 else 's'} as one flat "
                          f"week list, not split by day")
            elif not n_tasks:
                reason = f"{week_label}'s Actio is empty"
            elif args.all_week:
                reason = f"nothing allocated to any day in {week_label}'s Actio"
            else:
                reason = f"nothing allocated to {WEEKDAY_NAME} in {week_label}'s Actio"
    else:
        records = list(parse_note(lines, routines=args.routines))
        if not records:
            reason = f"{target} has no tasks"

# ── Assemble ──────────────────────────────────────────────────────────────────

rows = []          # (status, name, children) — children None for a bare task
if args.flat:
    flat = [(s, n, q) for _, s, n, q in records if s not in PROJECT_STATUSES]
    for status, name in dedup(flat):
        if status_match(status):
            rows.append((status, name, None))
    rows.sort(key=lambda r: r[1].lower())   # --flat: alphabetical only
else:
    for status, name, children in build_groups(records):
        if children is None:
            if status_match(status):
                rows.append((status, name, None))
            continue
        kids = [(s, n) for s, n in dedup(children) if status_match(s)]
        kids.sort(key=lambda k: sort_key(k[0], k[1]))
        # A project whose every child was filtered out is not worth a header.
        if kids:
            rows.append((status, name, kids))
    rows.sort(key=lambda r: sort_key(r[0], r[1]))

# ── Output ────────────────────────────────────────────────────────────────────

if args.json:
    print(json.dumps({
        'date': target,
        # -A spans the whole week, so no single weekday describes the payload.
        'weekday': None if args.all_week else WEEKDAY_NAME,
        'week': week_label,
        'source': source,
        'reason': reason,
        'notes': notes_read,
        'tasks': [
            {'status': s, 'name': n,
             'children': None if k is None else [{'status': cs, 'name': cn} for cs, cn in k]}
            for s, n, k in rows
        ],
    }, ensure_ascii=False, indent=2))
    sys.exit(0)

if args.all_week and args.plan:
    print(f'{BOLD}{week_label}{RESET}  {DIM}·{RESET}  {CYAN}plan{RESET}')
elif args.all_week:
    # Coverage is worth stating: a thin week is usually missing notes, not idle.
    print(f'{BOLD}{week_label}{RESET}  {DIM}·{RESET}  {CYAN}actual{RESET}'
          f'  {DIM}·{RESET}  {len(notes_read)}/7 notes')
else:
    print(f"{BOLD}{target}{RESET}  {DIM}·{RESET}  {WEEKDAY_NAME[:3]}  {DIM}·{RESET}  {CYAN}{source}{RESET}")
print()

leaves = 0
for status, name, kids in rows:
    print(f"  [{status}] {name}")
    if kids is None:
        leaves += 1
        continue
    for cs, cn in kids:
        print(f"      [{cs}] {cn}")
        leaves += 1

if not rows:
    if reason and args.verbose:
        print(f"  {DIM}{reason}{RESET}")
    elif not args.no_summary:
        print(f"  {DIM}nothing to show{RESET}")
    sys.exit(0)

if not args.no_summary:
    groups = sum(1 for _, _, k in rows if k is not None)
    parts = [f"{leaves} task" + ('' if leaves == 1 else 's')]
    if groups:
        parts.append(f"{groups} project" + ('' if groups == 1 else 's'))
    print()
    print('  ' + f"  {DIM}·{RESET}  ".join(parts))
